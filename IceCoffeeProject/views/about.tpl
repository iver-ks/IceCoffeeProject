% rebase('layout.tpl', title='О нас', year=year)

<!-- About Section (раздел "О нас") -->
<section class="about-section">
    <!-- Заголовок -->
    <h2 class="about-title">ICECOFFEE это</h2>
    <!-- Основной контент -->
    <div class="about-content">
        <!-- Левая колонка: преимущества 1 и 2 -->
        <div class="about-column left-column">
            <!-- Блок преимущества №1 -->
            <div class="about-block">
                <span class="block-number">1</span>
                <h3 class="about-block-title">Высокое качество зерен</h3>
                <p class="about-block-text">
                    Мы отбираем только лучшие кофейные зерна из экологически чистых плантаций. 
                    Каждая партия проходит строгий контроль качества, чтобы вы могли насладиться 
                    идеальным вкусом в каждой чашке.
                </p>
            </div>
                
            <!-- Блок преимущества №2 -->
            <div class="about-block">
                <span class="block-number">2</span>
                <h3 class="about-block-title">Атмосфера вдохновения и уюта</h3>
                <p class="about-block-text">
                    Наши кофейни созданы для тех, кто ценит комфорт и эстетику. 
                    Уютный интерьер, приглушенный свет и аромат свежемолотого кофе 
                    создают идеальную атмосферу для работы, встреч или отдыха.
                </p>  
            </div>
        </div>
            
        <!-- Центральная часть (изображение кофе) -->
        <div class="about-center">
            <img src="/static/images/coffee-cup-about.png" alt="BODRIN Coffee" class="coffee-cup">
        </div>
            
        <!-- Правая колонка: преимущества 3 и 4 -->
        <div class="about-column right-column">
            <!-- Блок преимущества №3 -->
            <div class="about-block">
                <span class="block-number">3</span>
                <h3 class="about-block-title">Индивидуальный подход к каждому гостю</h3>
                <p class="about-block-text">
                    Мы верим, что каждый человек особенный. Наши бариста помогут 
                    подобрать идеальный напиток под ваше настроение и предпочтения. 
                    Любимый рецепт или новый вкус — мы услышим ваши пожелания.
                </p>
            </div>
                
            <!-- Блок преимущества №4 -->
            <div class="about-block">
                <span class="block-number">4</span>
                <h3 class="about-block-title">Профессиональная команда бариста</h3>
                <p class="about-block-text">
                    Наши бариста — настоящие эксперты своего дела. Они постоянно 
                    совершенствуют мастерство, участвуют в чемпионатах и знают о кофе 
                    абсолютно всё. Доверьтесь их опыту!
                </p>
            </div>
        </div>
</section>
